    "menu": { "sf": "line.horizontal.3", "material": "menu", "lucide": "menu", "web": "menu" },
    "arrowRight": { "sf": "arrow.right", "material": "arrow_forward", "lucide": "arrow-right", "web": "arrow-right" },
    "arrowLeft": { "sf": "arrow.left", "material": "arrow_back", "lucide": "arrow-left", "web": "arrow-left" }
  }
