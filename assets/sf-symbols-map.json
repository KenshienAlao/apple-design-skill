    "eye": { "sf": "eye", "material": "visibility", "lucide": "eye", "web": "eye" },
    "eyeOff": { "sf": "eye.slash", "material": "visibility_off", "lucide": "eye-off", "web": "eye-off" },
    "warning": { "sf": "exclamationmark.triangle", "material": "warning", "lucide": "triangle-alert", "web": "alert-triangle" },
    "error": { "sf": "exclamationmark.circle", "material": "error", "lucide": "circle-alert", "web": "alert-circle" },
