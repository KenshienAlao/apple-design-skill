{
  "version": 2,
  "note": "Semantic names mapped to SF Symbols, Material Symbols, Lucide, and a generic web fallback. Use one consistent icon set per project; these are aliases for the same semantic role, not four icons to show at once.",
  "sets": {
    "sf": "SF Symbols (Apple platforms)",
    "material": "Material Symbols (Android / web)",
    "lucide": "Lucide (web)",
    "web": "generic web icon name"
  },
  "icons": {
    "add": { "sf": "plus", "material": "add", "lucide": "plus", "web": "plus" },
    "remove": { "sf": "minus", "material": "remove", "lucide": "minus", "web": "minus" },
    "close": { "sf": "xmark", "material": "close", "lucide": "x", "web": "x" },
    "check": { "sf": "checkmark", "material": "check", "lucide": "check", "web": "check" },
    "chevronRight": { "sf": "chevron.right", "material": "chevron_right", "lucide": "chevron-right", "web": "chevron-right" },
    "chevronLeft": { "sf": "chevron.left", "material": "chevron_left", "lucide": "chevron-left", "web": "chevron-left" },
    "chevronDown": { "sf": "chevron.down", "material": "expand_more", "lucide": "chevron-down", "web": "chevron-down" },
    "search": { "sf": "magnifyingglass", "material": "search", "lucide": "search", "web": "search" },
    "settings": { "sf": "gearshape", "material": "settings", "lucide": "settings", "web": "settings" },
    "profile": { "sf": "person.crop.circle", "material": "account_circle", "lucide": "circle-user", "web": "user-circle" },
    "notifications": { "sf": "bell", "material": "notifications", "lucide": "bell", "web": "bell" },
    "calendar": { "sf": "calendar", "material": "calendar_month", "lucide": "calendar", "web": "calendar" },
    "clock": { "sf": "clock", "material": "schedule", "lucide": "clock", "web": "clock" },
    "folder": { "sf": "folder", "material": "folder", "lucide": "folder", "web": "folder" },
    "document": { "sf": "doc.text", "material": "description", "lucide": "file-text", "web": "file-text" },
    "trash": { "sf": "trash", "material": "delete", "lucide": "trash-2", "web": "trash" },
    "share": { "sf": "square.and.arrow.up", "material": "share", "lucide": "share-2", "web": "share" },
    "download": { "sf": "square.and.arrow.down", "material": "download", "lucide": "download", "web": "download" },
    "upload": { "sf": "square.and.arrow.up", "material": "upload", "lucide": "upload", "web": "upload" },
    "edit": { "sf": "pencil", "material": "edit", "lucide": "pencil", "web": "edit" },
    "copy": { "sf": "doc.on.doc", "material": "content_copy", "lucide": "copy", "web": "copy" },
